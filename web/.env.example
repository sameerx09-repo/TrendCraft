# Safe configuration template. Copy to private .env.local and fill locally.
# Never put real credentials in this example or in NEXT_PUBLIC_* variables.

# Required: PostgreSQL connection URI (pooled Supabase connections supported).
DATABASE_URL=

# Mock clients use private local fixtures; this is not a global no-spend switch.
MOCK_MODE=true

# Local background worker. Omit INNGEST_DEV for Inngest Cloud deployments.
INNGEST_DEV=1
APP_URL=http://localhost:3001
# Long random secret shared by local worker auth and private media signing.
AUTH_WORKER_TOKEN=
# Required for cloud Inngest callback signature verification.
INNGEST_SIGNING_KEY=

# Provider credentials; configure only what the selected workflow needs.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-hashtag-scraper
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
RUNWAY_API_KEY=
HEYGEN_API_KEY=
YOUTUBE_API_KEY=

# Separate SwayBees API and optional browser-login origin.
SWAYBEES_API_URL=http://localhost:5100
SWAYBEES_API_KEY=
SWAYBEES_WEB_URL=http://localhost:5100

# Public HTTPS origin serving signed creator-reference video URLs.
# Optional when a campaign uses an already published Instagram link.
ENGAGEMENT_PUBLIC_BASE_URL=
