# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local PGlite database + local file storage — Phase 4 swaps these for
# hosted Supabase Postgres/Storage, nothing here should ever be committed
/.pglite-data/
/storage/rendered-posts/*
/storage/talking-head-videos/*
!/storage/rendered-posts/.gitkeep
!/storage/talking-head-videos/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/storage/auth/

/output/
/public/brand-feed/
/public/runway-clips/
/public/viral-trend-clips/
